#!/bin/sh

# Safe first-boot defaults. The guided setup owns only administrator password,
# the primary WAN and basic Wi-Fi. The official theme remains as rescue.
uci -q set system.@system[0].hostname='companywrt-ax9000'
uci -q set luci.main.lang='zh_cn'
uci -q set luci.main.mediaurlbase='/luci-static/company'
uci -q set uhttpd.main.redirect_https='1'

channel=$(awk -F= '$1 == "CHANNEL" { print $2; exit }' /etc/companywrt/build.conf 2>/dev/null)
case "$channel" in
	rc|beta|stable) uci -q set "company.main.channel=$channel" ;;
esac

uci -q commit system
uci -q commit luci
uci -q commit uhttpd
uci -q commit company

# No default password or uplink secret is embedded. The local first-run wizard
# collects them after login. Official WAN input remains rejected.
exit 0

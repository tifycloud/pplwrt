# REVIEW TEMPLATE — do not paste until the log collector and transport are approved.
# OpenWrt logd can forward syslog without adding a large daemon:
#
# uci set system.@system[0].log_remote='1'
# uci set system.@system[0].log_ip='192.0.2.10'
# uci set system.@system[0].log_port='514'
# uci set system.@system[0].log_proto='tcp'
# uci changes system
#
# Plain syslog has no confidentiality. Use only inside an isolated management
# VLAN/WireGuard path; otherwise deploy a reviewed TLS-capable collector client.
# Never send credentials, OpenClash subscriptions or WireGuard private keys.

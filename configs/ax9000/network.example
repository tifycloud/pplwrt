# Documentation only. Confirm physical DSA names with `ip -br link` on the
# exact router; never commit PPPoE credentials.
UNICOM_DEVICE=wan      # 1 Gbit/s primary/default office role
MOBILE_DEVICE=lan4     # 100 Mbit/s stable-upload role (example only)
OFFICE_CIDR=192.168.50.0/24

# Generate a plan; there is no live apply command:
# company-network plan --unicom-device "$UNICOM_DEVICE" \
#   --mobile-device "$MOBILE_DEVICE" --office-cidr "$OFFICE_CIDR" \
#   --output /tmp/company-network-plan

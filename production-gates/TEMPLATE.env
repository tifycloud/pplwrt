# Copy to production-gates/<VERSION>.env only after redacted real-hardware tests.
# Never include serial numbers, MACs, public IPs, credentials, keys or raw logs.
APPROVED_FOR_STABLE=NO
VERSION=<VERSION>
BOARD=xiaomi,ax9000
HARDWARE_VARIANT=<CN_OR_INTERNATIONAL_AND_EXACT_MODEL_LABEL>
SECURE_BOOT_STATE=<OBSERVED_STATE_AND_OFFICIAL_FLOW_USED>
BOOT_SLOT=<OBSERVED_ACTIVE_AND_FALLBACK_SLOT>
MTD_LAYOUT=<REDACTED_LAYOUT_SUMMARY>
MTD_EVIDENCE_SHA256=<64HEX_REDACTED_EVIDENCE_BUNDLE_SHA256>
TEST_LOG_SHA256=<64HEX_REDACTED_TEST_BUNDLE_SHA256>
FIRMWARE_SHA256=<64HEX_RELEASE_SYSUPGRADE_SHA256>
RESCUE=FAIL
POWER_LOSS=FAIL
HE80=FAIL
DUAL_WAN=FAIL
IPV6=FAIL
VLAN=FAIL
WIREGUARD=FAIL
PBR=FAIL
OPENCLASH=FAIL
OTA=FAIL
HTTPS=FAIL
WAN_FIREWALL=FAIL
APPROVER=<NAMED_HUMAN_APPROVER>
APPROVED_AT=<YYYY-MM-DDTHH:MM:SSZ>

diff --git a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
index 1ddc73f09ec464b4fbeca05ece60ca44b1197cf6..e8d6f151ae175094afbe9d6c6031b553e709f4c5 100644
--- a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
@@ -257,6 +257,16 @@ platform_do_upgrade() {
 		CI_ROOT_UBIPART="rootfs"
 		nand_do_upgrade "$1"
 		;;
+	xiaomi,ax9000-darkyun)
+		# Darkyun U-Boot scans one 232 MiB UBI named rootfs. Keep kernel,
+		# rootfs and rootfs_data as volumes in that single MTD partition.
+		# Do not touch stock Xiaomi A/B flags: this bootloader does not use
+		# the upstream split ubi_kernel/rootfs topology.
+		CI_UBIPART="rootfs"
+		CI_KERNPART="kernel"
+		CI_ROOTPART="rootfs"
+		nand_do_upgrade "$1"
+		;;
 	spectrum,sax1v1k)
 		CI_KERNPART="0:HLOS"
 		CI_ROOTPART="rootfs"

diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8072-ax9000-darkyun.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8072-ax9000-darkyun.dts
new file mode 100644
index 0000000000000000000000000000000000000000..7bee998126d162e2cfbbbdffadfb29e981590cc5
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8072-ax9000-darkyun.dts
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * Xiaomi AX9000 with Darkyun U-Boot single large-UBI layout.
+ *
+ * This deliberately inherits the upstream AX9000 hardware description and
+ * changes only the device identity, boot root volume and NAND tail layout.
+ */
+
+#include "ipq8072-ax9000.dts"
+
+/ {
+	model = "Xiaomi AX9000 (Darkyun Large UBI)";
+	compatible = "xiaomi,ax9000-darkyun", "xiaomi,ax9000", "qcom,ipq8074";
+
+	chosen {
+		bootargs-append = " root=/dev/ubiblock0_1";
+	};
+};
+
+&qpic_nand {
+	nand@0 {
+		partitions {
+			/delete-node/ partition@1180000;
+			/delete-node/ partition@4980000;
+
+			partition@1180000 {
+				label = "rootfs";
+				reg = <0x1180000 0xe800000>;
+			};
+
+			partition@f980000 {
+				label = "cfg_bak";
+				reg = <0xf980000 0x80000>;
+			};
+		};
+	};
+};

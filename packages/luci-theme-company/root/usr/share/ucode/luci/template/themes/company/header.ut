{#
 CompanyWrt LuCI theme. Derived from the LuCI OpenWrt 2020 template structure,
 licensed under Apache-2.0; CompanyWrt styling and branding are MIT licensed.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#14292d" />
<meta name="description" content="CompanyWrt 企业路由器管理中心" />
<link rel="stylesheet" media="screen" href="{{ media }}/cascade.css?v=25.12.5-company.2-rc4" />
<link rel="icon" href="{{ media }}/logo.svg" sizes="any" />
<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
<script src="{{ resource }}/cbi.js?v=26.218.70234~1654281"></script>
<title>{{ striptags(`${boardinfo.hostname ?? 'CompanyWrt'}${dispatched?.title ? ` · ${_(dispatched.title)}` : ''}`) }}</title>
{% if (css): %}<style title="text/css">{{ css }}</style>{% endif %}
</head>
<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">

<p class="skiplink">
	<span><a href="#navigation">{{ _('Skip to navigation') }}</a></span>
	<span><a href="#content">{{ _('Skip to content') }}</a></span>
</p>

<header id="menubar">
	<h2 class="navigation"><a id="navigation" name="navigation">{{ _('Navigation') }}</a></h2>
	<a class="cw-brand" href="{{ dispatcher.build_url('admin', 'company') }}">
		<img src="{{ media }}/logo.svg" width="38" height="38" alt="" />
		<span><strong>CompanyWrt</strong><small>AX9000 企业路由</small></span>
	</a>
	<span class="hostname">{{ striptags(boardinfo.hostname ?? '?') }}</span>
	<span class="distversion">{{ version.distversion }} · {{ version.distrevision }}</span>
	<span id="indicators"></span>
</header>

<div id="modemenu" style="display:none"></div>

<div id="maincontainer">
	<aside id="mainmenu"></aside>
	<main id="maincontent">
		<a id="content" name="content"></a>
		{% if (getuid() == 0 && getspnam('root')?.pwdp === '' && join('-', ctx.request_path) != 'admin-system-admin'): %}
		<div class="alert-message warning cw-password-warning">
			<div><strong>还没有设置管理员密码</strong><p>先设置密码，再接入 WAN 或公司网络。</p></div>
			{% if (dispatcher.lookup('admin/system/admin')): %}
			<a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">立即设置</a>
			{% endif %}
		</div>
		{% endif %}

		{% if (boardinfo.rootfs_type == 'initramfs'): %}
		<div class="alert-message warning">当前运行的是临时 initramfs 系统，重启后设置不会保留。</div>
		{% endif %}

		<div id="tabmenu" style="display:none"></div>

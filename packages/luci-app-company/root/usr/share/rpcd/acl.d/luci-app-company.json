{
  "luci-app-company": {
    "description": "CompanyWrt dashboard and guided first-run setup",
    "read": {
      "uci": ["company", "network", "wireless", "luci", "liquid", "firewall", "pbr"],
      "ubus": {
        "system": ["board", "info"],
        "luci-rpc": ["getDHCPLeases"],
        "network.interface": ["dump"]
      }
    },
    "write": {
      "uci": ["company", "network", "wireless", "luci", "liquid"],
      "ubus": {
        "luci": ["setPassword"]
      }
    }
  }
}
